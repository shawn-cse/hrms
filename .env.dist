# HRMS production environment template
DEBUG=False
HRMS_ENV=production
SECRET_KEY=change-me-with-a-long-random-django-secret
ALLOWED_HOSTS=hrms.example.com
CSRF_TRUSTED_ORIGINS=https://hrms.example.com
TIME_ZONE=Asia/Dhaka

# PostgreSQL
POSTGRES_DB=hrms_db
POSTGRES_USER=hrms_user
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql://hrms_user:change-me-postgres-password@db:5432/hrms_db
DB_INIT_PASSWORD=change-me-database-initialization-password
DB_ENGINE=django.db.backends.postgresql
DB_NAME=hrms_db
DB_USER=hrms_user
DB_PASSWORD=change-me-postgres-password
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# Security / Gunicorn
SECURE_SSL_REDIRECT=1
GUNICORN_WORKERS=
GUNICORN_LOG_LEVEL=info

# Optional external documentation/help URL. Leave empty to disable external docs.
DOC_BASE_URL=

# Optional GCP private media storage
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GS_BUCKET_NAME=your-private-bucket
# DEFAULT_FILE_STORAGE=hrms.hrms_backends_gcp.PrivateMediaStorage
